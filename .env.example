# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real keys.

# ---------------------------------------------------------------------------
# Phase 1 (face detection) — all optional, sensible defaults in config.py
# ---------------------------------------------------------------------------
# INSIGHTFACE_MODEL=buffalo_l   # or buffalo_s for a smaller/faster pack
# DET_SIZE=640                  # detector input size (square)
# DET_THRESHOLD=0.5             # minimum detector confidence
# USE_CPU=true                  # CPU inference first; set false to try GPU

# ---------------------------------------------------------------------------
# Phase 2 (reverse image search) — SerpApi Google Lens.
# Get a free key at https://serpapi.com/manage-api-key (100 searches/month).
# ---------------------------------------------------------------------------
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_lens

# ---------------------------------------------------------------------------
# Phase 4 (blockchain) — Ethereum Sepolia. NOT used in Phase 1.
# Use a THROWAWAY test wallet funded only with Sepolia test ETH.
# ---------------------------------------------------------------------------
ETH_RPC_URL=            # e.g. https://sepolia.infura.io/v3/<project-id>
ETH_PRIVATE_KEY=        # throwaway test key ONLY — never a real-funds key
ETH_CHAIN_ID=11155111   # Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_74p7XD3GkwiPIO6awb_Lo
WALLET_ADDRESS=0xAEDCd1d4D7e82f1e9d701c4A096438067ae6d86A
PRIVATE_KEY=90a9bc50a275f75ad31772e03423cd3cee2d9f474618ccb15df01a70996c2d76
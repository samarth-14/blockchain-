# --- Secrets: never commit ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- InsightFace / ONNX model cache (large, auto-downloaded) ---
# The models download on first run; no need to version them.
models/
*.onnx

# --- Pipeline artifacts (generated at runtime) ---
data/candidates/*
data/results/*
# Keep the input folder tracked but not private test images:
data/input/*
!data/**/.gitkeep

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
